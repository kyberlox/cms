# =============================================================================
# Deepsel CMS — deployment configuration
# Copy this file to `.env` (make setup) and edit the values.
# `.env` is gitignored — never commit real secrets.
# =============================================================================

# ------------------------------- Domain / TLS --------------------------------
# Public domain of the CMS (must point at this server via DNS A/AAAA record).
DOMAIN=cms.yourdomain.com
# Email used by Let's Encrypt for the certificate.
CERTBOT_EMAIL=admin@yourdomain.com
# Use the Let's Encrypt STAGING CA (no rate limits, fake certs) while testing.
CERTBOT_STAGING=false

# ------------------------------- PostgreSQL ----------------------------------
# Credentials for the database container (POSTGRES_* create the DB/user) and
# for the Deepsel backend (DB_*). Keep them the same.
POSTGRES_DB=deepsel
POSTGRES_USER=deepsel
POSTGRES_PASSWORD=CHANGE_ME_postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=deepsel
DB_USER=deepsel
DB_PASSWORD=CHANGE_ME_postgres

# ------------------------------- Deepsel admin -------------------------------
# Login for the admin panel (https://DOMAIN/admin).
# Default seeded admin is `admin`/`1234`; these env vars override it on every
# container start (see docker/set_admin.py).
DS_ADMIN_USERNAME=admin
DS_ADMIN_PASSWORD=CHANGE_ME_admin
DS_ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------- Deepsel backend -----------------------------
# Secret used for JWT/session signing & encryption of stored API keys.
# Generate with: openssl rand -hex 32
APP_SECRET=CHANGE_ME_64_hex_chars
# https:// and relative to the domain. Used for emails, canonical links.
FRONTEND_URL=https://cms.yourdomain.com
# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=https://cms.yourdomain.com

INSTALLED_APPS=core,cms
APP_DIRS=apps,deepsel.apps
FILESYSTEM=local
UPLOAD_SIZE_LIMIT=5              # max file upload, MB
SESSION_STORE=postgres           # postgres | redis | filesystem
SESSION_COOKIE_SECURE=true
CLIENT_HOST=0.0.0.0
CLIENT_PORT=4321
NO_CLIENT=false
SHELL=/bin/bash
ENABLE_GRAPHQL=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------- Optional ------------------------------------
# S3 / Azure blob storage (leave FILESYSTEM=s3|azure to enable)
# S3_BUCKET=
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# Unsplash access key (stock-image search in the admin)
# UNSPLASH_ACCESS_KEY=

# Redis-backed sessions — uncomment and add a `redis` service to the compose
# # file if you want it.
# REDIS_URL=redis://redis:6379
# SESSION_STORE=redis

# ------------ AI / LLM ("vibe coding" the frontend in the admin) ------------
# Deepsel's built-in AI features (content writing, template generation,
# chatbox, autocomplete, translation) talk to OpenRouter. The API key and
# model choices are configured per-organization IN THE ADMIN UI
# (Organization settings), stored encrypted in the DB — there is deliberately
# NO env var for it.
# OpenRouter aggregates OpenAI, DeepSeek, Google, Anthropic and many other
# models under one OpenAI-compatible API. To use your own local/self-hosted
# model, run an OpenAI-compatible gateway behind any LLM you like and point a
# custom "openrouter model" row at it (see README).
# OPENROUTER_API_KEY=

# ------------------------------- Git -----------------------------------------
# Your remote for this repo (used by `make setup-git` / `make push`).
GIT_REMOTE=https://github.com/you/cms.yourdomain.com.git
GIT_REMOTE_NAME=origin
GIT_BRANCH=main