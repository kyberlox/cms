# =============================================================================
# Deepsel CMS — configuration (ALL OPTIONAL)
#
# The stack works out of the box with the defaults below. `make deploy` / `make
# setup` create this file automatically (with random secrets) if it's missing,
# so you don't have to write anything. Values you leave alone get sane defaults.
# `.env` is gitignored — never commit real secrets.
# =============================================================================

# --------------------------------- Domain / TLS --------------------------------
# Public domain that points at this server (A/AAAA record). Used for nginx and
# the Let's Encrypt certificate. Until you run `make ssl-init`, the site runs
# behind a self-signed certificate.
DOMAIN=cms.example.com
# Email used by Let's Encrypt for the certificate.
CERTBOT_EMAIL=admin@example.com
# true = Let's Encrypt STAGING (no rate limits, fake certs) while testing.
CERTBOT_STAGING=false

# --------------------------------- PostgreSQL ---------------------------------
# These are generated automatically on first run — change only if you WANT to.
POSTGRES_DB=deepsel
POSTGRES_USER=deepsel
POSTGRES_PASSWORD=CHANGE_ME_postgres
# The app connects as DB_USER/DB_PASSWORD. The container CREATES this role with
# these credentials on every start (docker/db_ensure.py), so even if the values
# above differ or you typos here, everything still works.
DB_NAME=deepsel
DB_USER=deepsel
DB_PASSWORD=CHANGE_ME_postgres
# DB_HOST / DB_PORT are FORCED to the internal service `db:5432` by compose —
# you can't break the connection by editing .env. Leave them alone.
# DB_HOST=db
# DB_PORT=5432

# ------------------------------ Deepsel admin --------------------------------
# Admin panel login at https://DOMAIN/admin. Applied on every start
# (docker/set_admin.py). Default seeded login was admin/1234.
DS_ADMIN_USERNAME=admin
DS_ADMIN_PASSWORD=CHANGE_ME_admin
DS_ADMIN_EMAIL=admin@example.com

# ----------------------------- Deepsel backend --------------------------------
# Secret for JWT/sessions and encryption of stored API keys.
APP_SECRET=CHANGE_ME_64_hex_chars
# Public URL (links in emails, canonical). nginx keeps working regardless.
FRONTEND_URL=https://cms.example.com
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://cms.example.com

INSTALLED_APPS=core,cms
APP_DIRS=apps,deepsel.apps
FILESYSTEM=local
UPLOAD_SIZE_LIMIT=5              # max file upload, MB
SESSION_STORE=postgres           # postgres | redis | filesystem
SESSION_COOKIE_SECURE=true
CLIENT_HOST=0.0.0.0
CLIENT_PORT=4321
NO_CLIENT=false
SHELL=/bin/bash
ENABLE_GRAPHQL=true
ENABLE_DOCS=true
LOG_LEVEL=INFO
# True only for local package development; leave off in production.
LOCAL_PACKAGES=false

# -------------------------------- Optional -----------------------------------
# S3 / Azure blob storage (switch FILESYSTEM to s3|azure)
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
# UNSPLASH_ACCESS_KEY=
# REDIS_URL=redis://redis:6379
# SESSION_STORE=redis

# ------------------------------- Client build --------------------------------
# On slow VPSes the first client build (Astro) can take longer than the defaults.
# Bump these when you see "Theme setup timed out" in logs.
# THEME_BUILD_TIMEOUT=1800          # seconds for `npm run build` (default 1800)
# THEME_NPM_TIMEOUT=900             # seconds for `npm install` (default 900)

# ------------- AI / LLM ("vibe coding" the frontend in the admin) -------------
# All AI features (content writing, template/theme generation, chatbox,
# autocomplete, translations) go through OpenRouter. The API key and model
# choices are configured per-organization IN THE ADMIN UI and stored encrypted
# in the DB — deliberately no env var. To use your own model, run any
# OpenAI-compatible gateway and point a model row at it (see README).

# ----------------------------------- Git -------------------------------------
# Used by `make setup-git` / `make push` / `make pull`.
GIT_REMOTE=
GIT_REMOTE_NAME=origin
GIT_BRANCH=main