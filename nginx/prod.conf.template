# Production server blocks. This is a TEMPLATE: the official nginx image
# substitutes the container env vars (only DOMAIN) into *.template files under
# /etc/nginx/templates/ -> /etc/nginx/conf.d/. nginx runtime variables such as
# $host / $remote_addr / $upgrade are left untouched automatically.

# --- HTTP :80 ---------------------------------------------------------------
# ACME webroot for certbot + redirect everything else to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS :443 --------------------------------------------------------------
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    # HSTS + basic hardening headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Attachments uploads (mirrors UPLOAD_SIZE_LIMIT; raise if you increase it)
    client_max_body_size 20m;

    # ACME renewals over HTTPS
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # API, uploads, OpenAPI docs -> FastAPI backend (http://deepsel:8000)
    location /api/ {
        proxy_pass http://deepsel:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Public site + admin UI -> Astro client spawned by the backend
    # (http://deepsel:4321)
    location / {
        proxy_pass http://deepsel:4321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}